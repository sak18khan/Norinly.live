# ============================================================
# Norinly Backend — Environment Variables Reference
# Copy this file to .env and fill in the values.
# For Render: add each variable in Service Settings > Environment
# ============================================================

# Server port (Render sets this automatically)
PORT=3001

# CORS: set to your Vercel frontend URL
# e.g.: https://norinly.vercel.app or https://norinly.com
ALLOWED_ORIGIN=https://YOUR_VERCEL_URL.vercel.app

# Firebase Admin SDK credentials
# Option A: Set GOOGLE_APPLICATION_CREDENTIALS to a path to your service account JSON file
# Option B: Paste the JSON content directly into FIREBASE_SERVICE_ACCOUNT_JSON
GOOGLE_APPLICATION_CREDENTIALS=./serviceAccountKey.json
